{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.19",
  "private": true,
  "description": "DSH Desktop — zero-config DeepSeek Harness desktop client",
  "author": "DSH Desktop Project",
  "homepage": "https://github.com/qinyre/dsh-Desktop",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.21.0",
  "desktopName": "dsh-desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:electron": "electron scripts/check-node.mjs",
    "smoke:sidecar": "vitest run -t \"sidecar smoke\"",
    "smoke:market": "vitest run -t \"market seed smoke\"",
    "smoke:guard": "vitest run -t \"plugin-guard smoke\"",
    "smoke:picker": "electron scripts/picker-readutf16-smoke.cjs",
    "smoke:hideconsole": "electron scripts/spawn-windowhide-smoke.cjs",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:signed": "node scripts/check-signing-env.mjs && electron-vite build && electron-builder --win nsis --config electron-builder.signed.mjs && node scripts/verify-signature.mjs",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:dir:linux": "electron-vite build && electron-builder --linux dir --publish never",
    "icons": "node scripts/make-icons.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "smoke:tray": "vitest run -t \"tray plugin manager smoke\""
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-hook-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-output-retention": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-spill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-time": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-workflow": "^0.1.2-rc.1",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.5",
    "pnpm": "10.34.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^26.2.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

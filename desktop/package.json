{
  "name": "dosket-desktop",
  "productName": "Dosket",
  "version": "0.1.0",
  "private": true,
  "description": "Dosket — zero-config DeepSeek Harness desktop client",
  "author": "Dosket Project",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "check:electron": "electron scripts/check-node.mjs",
    "smoke:sidecar": "vitest run -t \"sidecar smoke\"",
    "smoke:plugin": "vitest run -t \"plugin smoke\"",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "electron-updater": "^6.8.9",
    "pnpm": "10.34.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
